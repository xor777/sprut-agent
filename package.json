{
  "name": "sprut-agent",
  "description": "Agent-first tools for configuring and debugging a SprutHub home",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "check": "biome check . && npm test",
    "format": "biome format --write .",
    "start": "node src/server.mjs",
    "eval:spruthub-master": "node research/evaluate-spruthub-master.mjs",
    "research:diff": "node research/compare-snapshots.mjs",
    "research:record": "node research/record-websocket.mjs",
    "research:snapshot": "node research/extract-spruthub.mjs",
    "test": "node --test",
    "test:mutations": "stryker run"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@stryker-mutator/core": "10.0.0",
    "husky": "9.1.7",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "license": "MIT"
}
