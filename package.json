{
  "name": "sprut-agent",
  "version": "0.1.15",
  "description": "Agent-first tools for configuring and debugging a SprutHub home",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "prepare": "husky",
    "check": "npm run check:plugin-bundle && biome check . && npm test",
    "check:plugin-bundle": "npm run build:plugin && git diff --exit-code -- dist && test -z \"$(git ls-files --others --exclude-standard -- dist)\"",
    "format": "biome format --write .",
    "start": "node src/server.mjs",
    "eval:spruthub-master": "node research/evaluate-spruthub-master.mjs",
    "research:diff": "node research/compare-snapshots.mjs",
    "research:record": "node research/record-websocket.mjs",
    "research:snapshot": "node research/extract-spruthub.mjs",
    "test": "node --test 'test/**/*.test.mjs' 'research/**/*.test.mjs'",
    "test:codex-install": "node --test 'test-codex-install/**/*.test.mjs'",
    "test:mutations": "stryker run"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@stryker-mutator/core": "10.0.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/curves": "2.4.0",
    "hash-wasm": "4.12.0",
    "js-tokens": "10.0.0",
    "zod": "4.5.4"
  },
  "license": "MIT"
}
